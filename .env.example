# Copy to .env.local for development. Set the same keys in Vercel for preview and
# production. Never commit real values — .env.local is gitignored.
# Full setup walkthrough: docs/STRIPE-CHECKOUT.md

# ── Site ────────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for Stripe success and cancel URLs.
# On Vercel this can be omitted in production (VERCEL_PROJECT_PRODUCTION_URL is
# used as a fallback), but set it explicitly once you are on the custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_… until you have tested end to end.
STRIPE_SECRET_KEY=sk_test_replace_me

# The Price id (starts price_…, NOT prod_…) for the $1,200 GTM Audit.
# Dashboard → Product catalogue → your product → the price → copy its API id.
STRIPE_AUDIT_PRICE_ID=price_replace_me

# Signing secret for the webhook endpoint. Two different values:
#   local dev  → run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#                and copy the whsec_… it prints
#   production → Dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Automatic sales tax at checkout. Left off deliberately.
# Whether a US business must collect sales tax on a consulting engagement depends
# on economic nexus per state and on whether the service is taxable there. Get that
# answered, activate Stripe Tax in the dashboard, then set this to true.
STRIPE_AUTOMATIC_TAX=false

# ── cal.com ─────────────────────────────────────────────────────────────────────
# The PAID audit working session event type, shown after payment. This must be a
# different event type from the free discovery call, otherwise buyers who have just
# paid land in the free-call calendar.
NEXT_PUBLIC_CAL_AUDIT_EVENT=growthstackhq/gtm-audit

# ── Sequenzy ────────────────────────────────────────────────────────────────────
# Sequenzy dashboard → Settings → API Keys.
# If unset, the site still takes payments and submits forms; the CRM write is
# skipped with a warning in the server logs.
SEQUENZY_API_KEY=

# Override only if Sequenzy tells you to. Defaults to https://api.sequenzy.com/api/v1
# SEQUENZY_BASE_URL=
